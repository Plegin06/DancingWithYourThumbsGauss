module LFSR_four (clk, bitout);
	input logic clk;
	output logic [9:0] bitout;
	
	
	//xnor
	logic feedback;
	assign feedback = ~ (bitout[9] ^ bitout[6]);
	
	always_ff @(posedge clk) begin
		if (feedback) begin
			bitout = { 1'b1, bitout[8:0] };
		end else begin
			bitout = { 1'b0, bitout[8:0] };
		end
	
	end
	
endmodule

module LFSR_four_testbench ();
	logic clk;
	logic [3:0] bitout;
	
	LFSR_ten dut (.clk, .bitout);
	
	parameter CLOCK_PERIOD=100;
	initial begin
		clk <= 0;
		forever #(CLOCK_PERIOD/2) clk <= ~clk; // Forever toggle the clock
	end

	
	initial begin
		bitout <= 4'b0000; @(posedge clk);
				repeat(30);
	
	
	end

endmodule 