module LED_cascade(RST, clk, counter_control, col_control, RedPixels, GrnPixels);
    input logic               RST, clk;
    output logic [15:0][15:0] RedPixels; // 16x16 array of red LEDs
    output logic [15:0][15:0] GrnPixels; // 16x16 array of green LEDs
	 input logic				  [2:0] counter_control;
	 input logic	[3:0] col_control;
	 logic 				  [10:0] counter, maximum;
	 logic				  [3:0][3:0] current_row;
	 logic		[15:0][3:0] REDpixel_div;
	 
	 always_comb begin
		case (counter_control)
			3'b000: maximum = 11'd128;
			3'b001: maximum = 11'd256;
			3'b010: maximum = 11'd400;
			3'b011: maximum = 11'd512;
			3'b100: maximum = 11'd700;
			3'b101: maximum = 11'd1024;
			default: maximum = 11'd2047;
		endcase
		
		for (int i = 0; i < 16; i++) begin
			RedPixels[i][3:0] = {4{REDpixel_div[i][0]}};
			RedPixels[i][7:4] = {4{REDpixel_div[i][1]}};
			RedPixels[i][11:8] = {4{REDpixel_div[i][2]}};
			RedPixels[i][15:12] = {4{REDpixel_div[i][3]}};
		end
	end
	 
	 always_ff @(posedge clk) begin
		if (RST) begin
			REDpixel_div <= '0;
			GrnPixels <= '0;
			counter <=  '0;
			current_row <= '0;
		end
		else begin
			counter <= counter + 1'b1;
		//turn on for half the counter cycle, off for the other half. about 0.63 seconds at this counter rate
			if (counter == maximum) begin
				if (col_control[0]) begin
					REDpixel_div[current_row[0]][0] <= 1'b1;
					REDpixel_div[current_row[0] - 1'b1][0] <= 1'b0;
					current_row[0] <= current_row[0] + 1'b1;
				end
				if (col_control[1]) begin
					REDpixel_div[current_row[1]][1] <= 1'b1;
					REDpixel_div[current_row[1] - 1'b1][1] <= 1'b0;
					current_row[1] <= current_row[1] + 1'b1;
				end
				if (col_control[2]) begin
					REDpixel_div[current_row[2]][2] <= 1'b1;
					REDpixel_div[current_row[2] - 1'b1][2] <= 1'b0;
					current_row[2] <= current_row[2] + 1'b1;
				end
				if (col_control[3]) begin
					REDpixel_div[current_row[3]][3] <= 1'b1;
					REDpixel_div[current_row[3] - 1'b1][3] <= 1'b0;
					current_row[3] <= current_row[3] + 1'b1;
				end
				
//				RedPixels[current] <= 16'b1111111111111111;
//				RedPixels[current - 1'b1] <= '0;
//				current <= current + 1'b1;
				counter <= '0;
				
			end
		end
	end

endmodule

module LED